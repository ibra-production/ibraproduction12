rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================================================
    // IBRA PRODUCTION — PRODUCTION-GRADE FIRESTORE SECURITY RULES
    // Project ID: ibra-production-web
    // Admin UID: v6CIpSmqqEWOFMvGu9ZxIapl4Ln1
    // Admin Email: bahibarhouma56@gmail.com
    // ==============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.uid == 'v6CIpSmqqEWOFMvGu9ZxIapl4Ln1' ||
        request.auth.token.email == 'bahibarhouma56@gmail.com'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- 1. Site Settings ---
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 2. Public Catalog: Services, Packages, Offers ---
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 3. Media & Showcase: Portfolio, Videos ---
    match /portfolio/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 4. Testimonials ---
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if true; // Public feedback submissions
      allow update, delete: if isAdmin();
    }

    // --- 5. Bookings & Reservations ---
    match /bookings/{bookingId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          resource.data.clientEmail == request.auth.token.email
        )
      );
      allow create: if true; // Public or client booking request
      allow update: if isAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // --- 6. Clients & CRM ---
    match /clients/{clientId} {
      allow read: if isAdmin() || isOwner(clientId);
      allow write: if isAdmin() || isOwner(clientId);
    }

    // --- 7. Client Portals (Wedding Tracker via Order Number) ---
    match /clientPortals/{portalId} {
      // Accessible by Admin or matching order tracking
      allow read: if true; // Portal query validated by order code in application logic
      allow write: if isAdmin();
    }

    // --- 8. Team Management (Specialties Dossiers) ---
    match /team/{memberId} {
      allow read: if true; // Published staff showcase
      allow write: if isAdmin();
    }

    // --- 9. Messages & Inquiries (Contact Form) ---
    match /messages/{messageId} {
      allow create: if true; // Public submission from contact form
      allow read, update, delete: if isAdmin();
    }

    // --- 10. Notifications ---
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.targetUid == request.auth.uid
      );
      allow write: if isAdmin();
    }

    // --- 11. Audit Logs & System Activity ---
    match /logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Default fallback deny for undefined paths
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
