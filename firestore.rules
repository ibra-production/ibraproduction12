rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "admin@ibraprod.online";
    }

    // Public website content: anyone can read, only the owner can modify.
    match /siteSettings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packages/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /portfolio/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /videos/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /offers/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Team profiles are public to display on the website,
    // but only the owner can create/change/delete them.
    match /teamMembers/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public booking submission. Clients cannot read, edit or delete bookings.
    // Require the minimum fields needed by the booking flow.
    match /bookings/{bookingId} {
      allow create: if
        request.resource.data.groomName is string
        && request.resource.data.groomName.size() >= 2
        && request.resource.data.groomName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8
        && request.resource.data.phone.size() <= 30
        && request.resource.data.eventType is string
        && request.resource.data.eventType.size() >= 1
        && request.resource.data.eventType.size() <= 100
        && request.resource.data.eventTime is string
        && request.resource.data.eventTime.size() <= 50
        && request.resource.data.venue is string
        && request.resource.data.venue.size() <= 250
        && request.resource.data.status == "new";

      allow read, update, delete: if isAdmin();
    }

    // Push notification tokens must never be readable/writable by ordinary users.
    match /pushTokens/{token} {
      allow read, create, update, delete: if isAdmin();
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
