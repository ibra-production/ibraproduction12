rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn();
    }

    // Public website content: anyone can read, only the owner can modify.
    match /siteSettings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packages/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /portfolio/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /videos/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /offers/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Team profiles are public to display on the website,
    // but only the owner can create/change/delete them.
    match /teamMembers/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings collection: two-way synchronization between website and native Android app.
    // Clients can submit new bookings with status == "new".
    // Status and administrative fields can ONLY be changed by admins.
    match /bookings/{bookingId} {
      allow create: if
        request.resource.data.groomName is string
        && request.resource.data.groomName.size() >= 2
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8
        && request.resource.data.status == "new";

      // Allow admin full read, and allow clients to read/track their bookings in real-time
      allow read: if true;

      // Only admins can alter status, clientCode, assigned team, or admin fields.
      // Non-admins can only update non-critical client fields without altering status.
      allow update: if isAdmin() || (
        request.resource.data.status == resource.data.status
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'clientId', 'clientCode', 'adminNotes', 'assignedTeam', 'internalNotes'])
      );

      allow delete: if isAdmin();
    }


    // Client portal documents are readable by anyone holding the unguessable portal code.
    // Only the admin can create/update/delete portal snapshots.
    match /clientPortals/{portalCode} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Internal workflow data is admin-only.
    match /bookingWorkflows/{bookingId} {
      allow read, write: if isAdmin();
    }

    // Push notification tokens must never be readable/writable by ordinary users.
    match /pushTokens/{token} {
      allow read, create, update, delete: if isAdmin();
    }

    match /automationQueue/{eventId} {
      allow read, write: if isAdmin();
    }

    match /scanLogs/{scanId} {
      allow read, write: if isAdmin();
    }

    // Operations Center: private CRM and production records.
    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }

    match /galleryItems/{galleryId} {
      allow read, write: if isAdmin();
    }

    match /usbRecords/{recordId} {
      allow read, write: if isAdmin();
    }

    match /adminPermissions/{permissionId} {
      allow read, write: if isAdmin();
    }

    match /contracts/{contractId} {
      allow read, write: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
